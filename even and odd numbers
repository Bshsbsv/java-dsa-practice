public class CountEvenOdd{
   public static void main(String [] args){
        int [] num = {2,5,8,11,4,6,};
        int evenCount= 0;
        int oddCount = 0;
        for(int i = 0; i<num.lenght; i ++){
             if(num[i] % 2 == 0){
                  evenCount++;
             }else{
               oddCount++;
            }
      }
      System.out.println("Even: " + evenCount);
      System.out.println("Odd: " + oddCount);
  }

}
