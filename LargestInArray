public class LargestInArray{
  public static void main(String [] args){
      int [] num = { 12,45,7,89,23};
      int largest = num[0];
      for(int i = 1; i< num.length; i++){
          if(num[i] > largest){

             largest = num[i];
          }
      }
      System.out.println(largest);
 }



}
 

